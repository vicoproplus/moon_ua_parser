+// moonbitlang/async 0.21.x changed http.Request.headers from
+// Map[String, String] to Map[CaseInsensitiveString, String]. Adapt at the
+// request-header boundary, behavior-preserving: the CI-keyed map itself
+// performs case-insensitive lookups, and the copied String-keyed map feeds
+// the unchanged String-based helpers below (which lowercase explicitly).
+// Required because the workspace also contains mizchi/mars@0.3.12, which
+// pins async@0.21.3, and moon resolves one shared version per registry
+// package across all workspace members. See the T-05 task report.
+fn request_headers_to_string_map(
+  request : @http.Request,
+) -> Map[String, String] {
+  let converted : Map[String, String] = Map([])
+  for pair in request.headers {
+    let (key, value) = pair
+    converted.set(key.to_string(), value)
+  }
+  converted
+}
