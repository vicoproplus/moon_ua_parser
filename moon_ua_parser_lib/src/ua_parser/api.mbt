///|
/// STUB for compile — replaced by T-06.
///
/// Parse a user-agent string into its browser, OS and device components.
/// The stub always succeeds with the all-miss fallback `UaInfo`.
pub fn parse(ua : String) -> Result[UaInfo, UaError] {
  ignore(ua)
  Ok({
    browser: { family: "Other", major: None, minor: None, patch: None, },
    os: {
      family: "Other",
      major: None,
      minor: None,
      patch: None,
      patch_minor: None,
    },
    device: { family: "Other", brand: None, model: None, },
  })
}

///|
